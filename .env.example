# Model configuration

# Path to the OpenVINO model directory
MODEL_PATH=./models/Qwen3-VL-4B-Instruct-int4-ov

# OpenVINO inference device: GPU | CPU | AUTO (local backend only)
OPENVINO_DEVICE=GPU

# OCR backend: remote (Ollama/OpenAI-compatible endpoint) or local (OpenVINO)
OCR_BACKEND=remote

# Remote VLM endpoint settings
OLLAMA_BASE_URL=http://34.63.203.19:11434/v1
OLLAMA_API_KEY=EMPTY
OLLAMA_MODEL=qwen2.5-vl:7b

# Remote request timeout (seconds) — VLM inference can take minutes
OLLAMA_TIMEOUT=300

# Max output tokens per OCR request (must fit all regions as JSON)
OLLAMA_MAX_TOKENS=3500

# Qwen bbox coordinate convention: auto | normalized | pixels.
# auto = 0-1000 responses are scaled to pixels, larger values pass through.
OCR_COORD_MODE=auto

# Image processing

# Inpainting brush radius (pixels)
INPAINT_RADIUS=5

# Extra padding (pixels) added to each bounding box before inpainting
BBOX_PADDING=2

# Text rendering

# Path to the TrueType font used for rendering translated text
FONT_PATH=./fonts/DejaVuSans.ttf

# Font size range (auto-fit will try sizes from MAX down to MIN)
FONT_SIZE_MAX=40
FONT_SIZE_MIN=6
